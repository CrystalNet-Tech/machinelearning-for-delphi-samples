# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: DeepSeek API
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Alternative: Claude API (if using Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Market Data API Keys (Optional)
# US Market Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Chinese A-Share Market Data
TUSHARE_TOKEN=your_tushare_token

# Agent Configuration
SIGNATURE=my_agent_v1

# Runtime Environment Path (Optional - auto-generated if not set)
# RUNTIME_ENV_PATH=data/agent_data/my_agent_v1/.runtime_env.json

# Logging Configuration
LOG_LEVEL=INFO
